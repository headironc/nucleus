set +x
set -Eeuo pipefail
set -o noclobber
umask 077

{{- if not .UseJITConfig }}
printf '%s\n' 'JIT configuration is required' >&2
exit 1
{{- end }}
{{- if .EnableBootDebug }}
printf '%s\n' 'Boot tracing is forbidden' >&2
exit 1
{{- end }}
{{- if or (ne .MetadataURL "https://10.203.64.1:9444/api/v1/metadata") (ne .CallbackURL "https://10.203.64.1:9444/api/v1/callbacks") (ne .RunnerUsername "runner") }}
printf '%s\n' 'Unexpected bootstrap endpoints or account' >&2
exit 1
{{- end }}

METADATA_URL='https://10.203.64.1:9444/api/v1/metadata'
CALLBACK_URL='https://10.203.64.1:9444/api/v1/callbacks'
RUN_HOME='/home/runner/actions-runner'
STAGE='preflight'

# A here-document keeps the instance JWT out of argv and shell evaluation.
IFS= read -r BEARER_TOKEN <<'GARM_INSTANCE_JWT'
{{ .CallbackToken }}
GARM_INSTANCE_JWT

post() {
    curl --silent --show-error --fail --connect-timeout 5 --max-time 20 \
        --proto '=https' --noproxy 10.203.64.1 --header @- \
        --header 'Content-Type: application/json' --request POST \
        --data-binary @/dev/fd/3 --output /dev/null "$CALLBACK_URL/$1" \
        3<<<"$2" <<<"Authorization: Bearer $BEARER_TOKEN"
}

status() {
    post status "{\"status\":\"$1\",\"message\":\"$2\",\"agent_id\":${3:-null}}"
}

failed() {
    trap - ERR
    # Let the parent report a failed command substitution exactly once.
    if (( BASH_SUBSHELL > 0 )); then
        exit 1
    fi
    printf 'Runner bootstrap failed at %s\n' "$STAGE" >&2
    status failed "Bootstrap failed at $STAGE" >/dev/null 2>&1 || true
    exit 1
}
trap failed ERR

metadata() {
    curl --silent --show-error --fail --connect-timeout 5 --max-time 20 \
        --proto '=https' --noproxy 10.203.64.1 --header @- \
        "$METADATA_URL/$1" <<<"Authorization: Bearer $BEARER_TOKEN"
}

getRunnerFile() {
    # The shell opens each identity file exclusively, before curl receives its FD.
    metadata "$1" >"$2"
}

[[ "$BEARER_TOKEN" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]]
[[ -x "$RUN_HOME/bin/Runner.Listener" && -f "$RUN_HOME/env.sh" && -f "$RUN_HOME/bin/runsvc.sh" ]]
for name in .runner .credentials .credentials_rsaparams .service; do
    [[ ! -e "$RUN_HOME/$name" && ! -L "$RUN_HOME/$name" ]]
done
cd "$RUN_HOME"

# Reuse the base image's proxy setup, rejecting drift before JIT credentials arrive.
cmp -s /etc/nucleiron-proxy.env /dev/fd/3 3<<'EXPECTED_PROXY'
http_proxy=http://10.203.64.1:3128
https_proxy=http://10.203.64.1:3128
HTTP_PROXY=http://10.203.64.1:3128
HTTPS_PROXY=http://10.203.64.1:3128
no_proxy=localhost,127.0.0.1,10.203.64.1
NO_PROXY=localhost,127.0.0.1,10.203.64.1
EXPECTED_PROXY
set -a
. /etc/nucleiron-proxy.env
set +a
cmp -s /etc/systemd/system/docker.service.d/proxy.conf /dev/fd/3 3<<'DOCKER_PROXY'
[Service]
EnvironmentFile=/etc/nucleiron-proxy.env
DOCKER_PROXY
jq -e '.proxies.default == {httpProxy:"http://10.203.64.1:3128",httpsProxy:"http://10.203.64.1:3128",noProxy:"localhost,127.0.0.1,10.203.64.1"} and keys == ["proxies"]' \
    /home/runner/.docker/config.json >/dev/null
[[ "$(docker version --format '{{ "{{.Client.Version}} {{.Server.Version}}" }}')" == '29.1.3 29.1.3' ]]

# The reused image forwards rsyslog to the old collector; stop it before any JIT request.
sudo -n systemctl disable --now rsyslog.service >/dev/null 2>&1
if sudo -n systemctl is-active --quiet rsyslog.service; then
    failed
fi

STAGE='docker-cold-store'
[[ ! -v DOCKER_HOST && ! -v DOCKER_CONTEXT ]]
COLD_DOCKER_CONTEXT=$(docker context show 2>/dev/null)
[[ "$COLD_DOCKER_CONTEXT" == 'default' ]]
docker context inspect default 2>/dev/null | jq -e \
    'length == 1 and .[0].Name == "default" and .[0].Endpoints.docker.Host == "unix:///var/run/docker.sock"' \
    >/dev/null 2>&1
COLD_DOCKER_IMAGES=$(docker image ls --all --quiet 2>/dev/null)
[[ -z "$COLD_DOCKER_IMAGES" ]]
COLD_DOCKER_CONTAINERS=$(docker container ls --all --quiet 2>/dev/null)
[[ -z "$COLD_DOCKER_CONTAINERS" ]]
unset COLD_DOCKER_CONTEXT COLD_DOCKER_IMAGES COLD_DOCKER_CONTAINERS
status installing 'Verified empty Docker image and container stores before JIT'

STAGE='jit-files'
status installing 'Installing instance JIT identity'
getRunnerFile credentials/runner "$RUN_HOME/.runner"
getRunnerFile credentials/credentials "$RUN_HOME/.credentials"
getRunnerFile credentials/credentials_rsaparams "$RUN_HOME/.credentials_rsaparams"
AGENT_ID=""
SVC_BASE=$(metadata system/service-name)
[[ "$SVC_BASE" =~ ^actions\.runner\.[A-Za-z0-9_.-]+$ ]]
SVC_NAME="$SVC_BASE.service"
# systemd unit names are ASCII here and allow at most 255 bytes.
[[ ${#SVC_NAME} -le 255 ]]
printf '%s\n' "$SVC_NAME" >"$RUN_HOME/.service"

STAGE='service-install'
[[ ! -e "/etc/systemd/system/$SVC_NAME" && ! -L "/etc/systemd/system/$SVC_NAME" ]]
[[ ! -e "/etc/systemd/system/$SVC_NAME.d" && ! -L "/etc/systemd/system/$SVC_NAME.d" ]]
getRunnerFile 'systemd/unit-file?runAsUser=runner' "$RUN_HOME/$SVC_NAME"
sudo -n install -m 0644 -o root -g root "$RUN_HOME/$SVC_NAME" "/etc/systemd/system/$SVC_NAME"
sudo -n install -d -m 0755 "/etc/systemd/system/$SVC_NAME.d"
sudo -n install -m 0644 -o root -g root /dev/stdin "/etc/systemd/system/$SVC_NAME.d/proxy.conf" <<'RUNNER_PROXY'
[Service]
EnvironmentFile=/etc/nucleiron-proxy.env
RUNNER_PROXY
cp "$RUN_HOME/bin/runsvc.sh" "$RUN_HOME/runsvc.sh"
bash "$RUN_HOME/env.sh" >/dev/null 2>&1
sudo -n systemctl daemon-reload
sudo -n systemctl enable "$SVC_NAME" >/dev/null 2>&1

STAGE='service-start'
sudo -n systemctl start "$SVC_NAME"
sudo -n systemctl is-active --quiet "$SVC_NAME"
. /etc/os-release
PAYLOAD=$(jq -cn --arg name "${NAME:-}" --arg version "${VERSION_ID:-}" --argjson id "${AGENT_ID:-null}" \
    '{os_name:$name,os_version:$version,agent_id:$id}')
post system-info "$PAYLOAD"
status idle 'Runner service started' "$AGENT_ID"
printf '%s\n' 'Runner bootstrap complete'
