page { background: #f8f6ef; color: #2f3731; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 30rpx; }
.page { padding: 48rpx 40rpx 72rpx; max-width: 880rpx; margin: 0 auto; box-sizing: border-box; }
.eyebrow { color: #55684e; font-size: 24rpx; letter-spacing: 3rpx; margin-bottom: 32rpx; }
.hero-title { font-family: "Songti SC", serif; font-size: 72rpx; line-height: 1.35; margin: 50rpx 0 24rpx; font-weight: 600; }
.line-break { display: block; }
.hero-copy, .body-copy { color: #5b655c; font-size: 28rpx; line-height: 1.8; }
.intro-card { padding: 36rpx; border: 1rpx solid #ddd6c6; border-radius: 16rpx; background: #fffefa; margin: 36rpx 0; }
.section-label { color: #55684e; font-size: 23rpx; letter-spacing: 2rpx; margin-bottom: 20rpx; }
.card-title { font-size: 38rpx; font-weight: 600; margin-bottom: 18rpx; }
.page-title { font-family: "Songti SC", serif; font-size: 52rpx; font-weight: 600; margin: 24rpx 0 30rpx; }
.notice { color: #5b655c; font-size: 28rpx; line-height: 1.8; padding: 24rpx 28rpx; background: #f1ede3; border-radius: 8rpx; margin: 24rpx 0; }
button { box-sizing: border-box; font-size: 30rpx; line-height: 1.5; padding: 24rpx 20rpx; margin: 24rpx 0 0; border-radius: 8rpx; font-weight: 500; }
button::after { border: 0; }
.primary { color: #fffdf8; background: #a3402b; }
.secondary { color: #2f3731; background: #fffefa; border: 1rpx solid #7d8578; }
.text-button { color: #55684e; background: transparent; }
.danger { color: #9b2a4a; }
button[disabled] { opacity: .55; }
.small-copy, .footnote { color: #5b655c; font-size: 24rpx; line-height: 1.8; margin-top: 22rpx; }
.field-label { display: block; margin: 32rpx 0 14rpx; font-size: 28rpx; }
.field { display: block; box-sizing: border-box; min-height: 96rpx; padding: 20rpx; border: 1rpx solid #7d8578; border-radius: 8rpx; background: #fff; font-size: 30rpx; }
.profile { display: flex; align-items: center; gap: 24rpx; margin-bottom: 36rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; flex-shrink: 0; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; color: #55684e; background: #e9e3d5; font-size: 42rpx; }
.profile-name { font-size: 40rpx; font-weight: 600; overflow-wrap: anywhere; }
.profile .small-copy { margin-top: 6rpx; }
.detail-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 28rpx 0; border-top: 1rpx solid #ddd6c6; font-size: 28rpx; }
.separator { height: 1rpx; background: #ddd6c6; margin-top: 30rpx; }
.home-link { display: block; text-align: center; color: #55684e; font-size: 28rpx; margin-top: 40rpx; padding: 20rpx; }
