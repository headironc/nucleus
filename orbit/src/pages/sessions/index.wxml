<view class="page sessions-page self-page {{sessionsReady ? '' : 'self-state'}}">
  <view class="self-status-emblem {{busy ? 'self-spinner' : ''}}" wx:if="{{!sessionsReady}}" aria-hidden="true"><text wx:if="{{!busy}}">{{phase === 'complete' ? '✓' : '!'}}</text></view>
  <view class="page-title">{{heading}}</view>
  <view class="body-copy" wx:if="{{sessionsReady}}">查看网站和小程序的登录情况，按需退出。</view>
  <view class="{{sessionsReady ? 'notice' : 'body-copy self-status-copy'}}" wx:if="{{message && !busy}}" role="status">{{message}}</view>

  <!-- snapshot:sessions:start -->
  <view class="session-list" wx:if="{{sessionsReady}}">
    <view class="session-row" wx:for="{{sessions}}" wx:key="id">
      <view class="source-icon {{item.sourceLabel === '网站' ? 'website-icon' : 'mini-icon'}}" aria-hidden="true"></view>
      <view class="session-copy"><view class="session-source">{{item.sourceLabel}}</view><view class="session-date">登录于 {{item.date}}</view></view>
      <text class="session-current" wx:if="{{item.current}}">本次登录</text>
      <button class="session-exit" wx:else data-id="{{item.id}}" bindtap="logoutOther" disabled="{{busy || logoutPending}}" aria-label="退出{{item.sourceLabel}} {{item.date}}">退出</button>
    </view>
  </view>
  <view class="session-all" wx:if="{{sessionsReady}}">
    <view class="session-all-copy"><view class="card-title">退出全部登录</view><view class="body-copy">退出网站和小程序的全部登录，包括本次登录。</view></view>
    <button class="session-exit danger" bindtap="logoutAll" disabled="{{busy || logoutPending}}">全部退出</button>
  </view>
  <!-- snapshot:sessions:end -->

  <button class="primary self-button" wx:if="{{canCheck && !sessionsReady && phase !== 'complete'}}" bindtap="refresh" disabled="{{busy}}">{{phase === 'sessions' ? '刷新列表' : phase === 'unavailable' ? '重新检查' : '检查登录状态'}}</button>
  <button class="primary self-button" wx:if="{{canRecover}}" bindtap="recover" disabled="{{busy}}">{{recoveryLabel}}</button>
  <view class="self-inline-actions" wx:if="{{sessionsReady}}"><button class="text-button self-text-action" wx:if="{{canCheck && sessionsReady}}" bindtap="refresh" disabled="{{busy}}">刷新列表</button><navigator class="home-link" url="/pages/account/index" open-type="redirect">返回个人账户</navigator></view>
  <navigator class="home-link primary self-button" wx:if="{{phase === 'complete' && !homeAction && canCheck}}" url="/pages/account/index" open-type="redirect">返回个人账户</navigator>
  <navigator class="home-link primary self-button" wx:if="{{canLogin && !homeAction}}" url="/pages/account/index" open-type="redirect">使用手机号登录</navigator>
  <navigator class="home-link primary self-button" wx:if="{{homeAction}}" url="/pages/home/index" open-type="reLaunch">返回首页</navigator>
  <navigator class="home-link" wx:if="{{!homeAction && !canLogin && !sessionsReady && phase !== 'complete' && !(phase === 'pending' && (recoveryKind === 'login' || recoveryKind === 'registration') && !canRecover)}}" url="/pages/account/index" open-type="redirect">返回个人账户</navigator>
  <navigator class="home-link" wx:if="{{!homeAction && (canLogin || phase === 'complete' || (phase === 'pending' && (recoveryKind === 'login' || recoveryKind === 'registration') && !canRecover))}}" url="/pages/home/index" open-type="reLaunch">返回首页</navigator>
</view>
