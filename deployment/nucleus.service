[Unit]
Description=Nucleus C1 HTTP service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=nucleus
Group=nucleus
EnvironmentFile=/etc/nucleus/settings
LoadCredentialEncrypted=database.json:/etc/credstore.encrypted/nucleus-database
LoadCredentialEncrypted=challenge.json:/etc/credstore.encrypted/nucleus-challenge
LoadCredentialEncrypted=message.json:/etc/credstore.encrypted/nucleus-message
LoadCredentialEncrypted=keys.json:/etc/credstore.encrypted/nucleus-keys
ExecStart=/usr/local/bin/nucleus
KillMode=control-group
ExitType=cgroup
# Retained history is checked in bounded batches, without a total scan deadline.
TimeoutStartSec=infinity
TimeoutStopSec=35s
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
