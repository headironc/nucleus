[Unit]
Description=Halo website
After=network.target

[Service]
Type=simple
User=halo
Group=halo
WorkingDirectory=/srv/halo/current
ExecStart=/usr/bin/node /srv/halo/current/server.mjs
Environment=NODE_ENV=production
Environment=HALO_PORT=3080
# Required: the exact configured avatar HTTPS origin (may equal the site origin).
# Environment=HALO_AVATAR_ORIGIN=https://<avatar-origin>
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
