{
  "name": "nucleus-docs",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check:tools": "tsc --noEmit",
    "format:docs": "prettier --write AGENTS.md \"docs/**/*.md\"",
    "check:docs": "prettier --check AGENTS.md \"docs/**/*.md\" && markdownlint-cli2 AGENTS.md \"docs/**/*.md\"",
    "check:docs:links": "lychee --offline --no-progress --include-fragments=anchor-only AGENTS.md \"docs/**/*.md\""
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
